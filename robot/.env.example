# Gemini Live
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Puck

# Use identifying substrings from sounddevice's device list.
INPUT_DEVICE=Maono Elf
OUTPUT_DEVICE=AB13X USB Audio
INPUT_RATE=16000
INPUT_BLOCK_SIZE=0
INPUT_LATENCY=high
AUDIO_CHUNK_MS=40
MIC_VOICE_RMS_THRESHOLD=1200
LOCAL_SPEECH_MIN_SECONDS=0.25
LOCAL_SPEECH_SILENCE_SECONDS=0.9
VOICE_RESPONSE_TIMEOUT_SECONDS=12
WATCHDOG_INTERVAL_SECONDS=1

# Manual VAD is the reliable default for this noisy USB microphone. Set
# automatic only after verifying that Gemini consistently finalizes speech.
VAD_MODE=manual

# Keep false when using the robot's speaker. Set true only with headphones or acoustic echo cancellation.
ALLOW_BARGE_IN=false

OUTPUT_GAIN=2.0
ECHO_COOLDOWN=0.7
RECONNECT_INITIAL_SECONDS=3
RECONNECT_MAX_SECONDS=30

# Exact Arduino App Lab WebUI base URL. Replace 7000 with the port shown by App Lab if it differs. Do not add /api here.
ROBOT_API_BASE=http://127.0.0.1:7000
ROBOT_HTTP_TIMEOUT=2.0
